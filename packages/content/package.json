{
  "name": "@universityflow/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every user-visible string, per language.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "sideEffects": false,
