{
  "contract": "mmereko-partner-v1",
  "contractVersion": "2026-10-23.1",
  "about": "Golden cases both sides run (docs/integrations/universityflow-partner-api.md section 6.3). Mmereko runs them in tests/api/partner/test_contract.py; UniversityFlow vendors this folder into packages/cv/contract/ and runs the profiles block against its TypeScript validator and the requests block against MemoryCvEngine and, opt-in, Mmereko's sandbox. In a body, \"$NAME\" is replaced by values.NAME and \"@profiles/x\" / \"@adverts/x\" by fixtures/profiles/x.json / fixtures/adverts/x.json. Synthetic data only.",
  "values": {
    "LEARNER": "3f0c2a9e-6b7d-4e21-9a0f-1c2d3e4f5a6b",
    "CONSENT_UNDER_18": {
      "ref": "8d1e7c55-2b3a-4f60-8e19-0a1b2c3d4e5f",
      "version": "v4",
      "purposes": ["cv.draft", "cv.tailor", "cv.ats"],
      "ageBand": "under-18"
    },
    "CONSENT_ADULT_SHARE": {
      "ref": "1b2c3d4e-5f60-4718-8293-a4b5c6d7e8f9",
      "version": "adult-v3",
      "purposes": ["cv.draft", "cv.tailor", "cv.share"],
      "ageBand": "18-plus"
    },
    "CONSENT_UNDER_18_SHARE": {
      "ref": "8d1e7c55-2b3a-4f60-8e19-0a1b2c3d4e5f",
      "version": "v4",
      "purposes": ["cv.draft", "cv.share"],
      "ageBand": "under-18"
    },
    "CONSENT_TAILOR_ONLY": {
      "ref": "8d1e7c55-2b3a-4f60-8e19-0a1b2c3d4e5f",
      "version": "v4",
      "purposes": ["cv.tailor"],
      "ageBand": "under-18"
    },
    "CONSENT_DRAFT_ONLY": {
      "ref": "8d1e7c55-2b3a-4f60-8e19-0a1b2c3d4e5f",
      "version": "v4",
      "purposes": ["cv.draft"],
      "ageBand": "under-18"
    },
    "CONSENT_NO_REF": {
      "version": "v4",
      "purposes": ["cv.draft"],
      "ageBand": "under-18"
    },
    "RENDER": { "template": "ats-classic", "paper": "A4", "locale": "en-ZA", "maxPages": 1 },
    "CV_TEXT": "Naledi M.\nSkills: Python, Flask, Java.\nProjects: Campus bus tracker (Python, Flask)."
  },
  "profiles": [
    { "fixture": "valid-full", "valid": true, "problems": [] },
    { "fixture": "valid-minimal", "valid": true, "problems": [] },
    { "fixture": "valid-html-as-text", "valid": true, "problems": [],
      "note": "Plain text only: HTML and Markdown in a field are not refused, they are escaped and print as typed." },
    { "fixture": "invalid-id-number", "valid": false,
      "problems": [{ "path": "/basics/summary", "code": "id_number" }], "mustNotEcho": ["{{SYNTHETIC_SA_ID}}"] },
    { "fixture": "invalid-student-number", "valid": false,
      "problems": [{ "path": "/projects/0/description", "code": "student_number" }], "mustNotEcho": ["219345678"] },
    { "fixture": "invalid-http-url", "valid": false,
      "problems": [{ "path": "/basics/profiles/0/url", "code": "invalid_format" }],
      "mustNotEcho": ["http://github.com/example-learner"] },
    { "fixture": "invalid-ip-host-url", "valid": false,
      "problems": [{ "path": "/projects/0/xEvidence/1/url", "code": "url_host" }], "mustNotEcho": ["192.168.0.10"] },
    { "fixture": "invalid-localhost-url", "valid": false,
      "problems": [{ "path": "/projects/0/xEvidence/1/url", "code": "url_host" }], "mustNotEcho": ["localhost"] },
    { "fixture": "invalid-schema-version", "valid": false,
      "problems": [{ "path": "/schemaVersion", "code": "schema_version" }] },
    { "fixture": "invalid-unknown-field", "valid": false,
      "problems": [{ "path": "/basics", "code": "unknown_field" }], "mustNotEcho": ["dateOfBirth", "2009-04-01"],
      "note": "An unknown field is reported at its parent, never by name." },
    { "fixture": "invalid-missing-name", "valid": false,
      "problems": [{ "path": "/basics/name", "code": "required" }] },
    { "fixture": "invalid-summary-too-long", "valid": false,
      "problems": [{ "path": "/basics/summary", "code": "too_long" }] },
    { "fixture": "invalid-too-many-highlights", "valid": false,
      "problems": [{ "path": "/work/0/highlights", "code": "too_many" }] }
  ],
  "requests": [
    { "id": "draft-valid-full", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-full", "render": "$RENDER" },
      "expect": { "status": 202, "bodyKeys": ["jobId", "status"] } },
    { "id": "draft-valid-minimal", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 202 } },
    { "id": "draft-html-as-text", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-html-as-text" },
      "expect": { "status": 202 } },
    { "id": "draft-id-number", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-id-number" },
      "expect": { "status": 422, "code": "validation_failed", "retryable": false,
                  "problems": [{ "path": "/profile/basics/summary", "code": "id_number" }], "mustNotEcho": ["{{SYNTHETIC_SA_ID}}"] } },
    { "id": "draft-student-number", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-student-number" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/profile/projects/0/description", "code": "student_number" }], "mustNotEcho": ["219345678"] } },
    { "id": "draft-http-url", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-http-url" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/profile/basics/profiles/0/url", "code": "invalid_format" }],
                  "mustNotEcho": ["http://github.com/example-learner"] } },
    { "id": "draft-ip-host-url", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-ip-host-url" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/profile/projects/0/xEvidence/1/url", "code": "url_host" }], "mustNotEcho": ["192.168.0.10"] } },
    { "id": "draft-schema-version", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-schema-version" },
      "expect": { "status": 422, "code": "schema_version",
                  "problems": [{ "path": "/profile/schemaVersion", "code": "schema_version" }] } },
    { "id": "draft-unknown-field", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-unknown-field" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/profile/basics", "code": "unknown_field" }], "mustNotEcho": ["dateOfBirth", "2009-04-01"] } },
    { "id": "draft-missing-name", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/invalid-missing-name" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/profile/basics/name", "code": "required" }] } },
    { "id": "draft-no-consent", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 403, "code": "consent_required", "retryable": false } },
    { "id": "draft-consent-without-ref", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_NO_REF", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 403, "code": "consent_required" } },
    { "id": "draft-purpose-not-consented", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_TAILOR_ONLY", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 403, "code": "consent_required" } },
    { "id": "draft-under-18-share", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18_SHARE", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 403, "code": "share_not_allowed" } },
    { "id": "draft-adult-share", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_ADULT_SHARE", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 202 } },
    { "id": "draft-learner-ref-is-a-phone", "method": "POST", "path": "/cv-drafts",
      "body": { "learnerRef": "{{SYNTHETIC_PHONE}}", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-minimal" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/learnerRef", "code": "invalid_format" }], "mustNotEcho": ["{{SYNTHETIC_PHONE}}", "{{SYNTHETIC_PHONE_DIGITS}}"] } },
    { "id": "tailoring-valid", "method": "POST", "path": "/tailorings",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-full", "job": "@adverts/advert-python" },
      "expect": { "status": 202, "bodyKeys": ["jobId", "status"] } },
    { "id": "tailoring-no-description", "method": "POST", "path": "/tailorings",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-full", "job": "@adverts/advert-no-description" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/job/description", "code": "required" }] } },
    { "id": "tailoring-unknown-advert-field", "method": "POST", "path": "/tailorings",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "profile": "@profiles/valid-full", "job": "@adverts/advert-unknown-field" },
      "expect": { "status": 422, "code": "validation_failed",
                  "problems": [{ "path": "/job", "code": "unknown_field" }], "mustNotEcho": ["salary"] } },
    { "id": "tailoring-purpose-not-consented", "method": "POST", "path": "/tailorings",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_DRAFT_ONLY", "profile": "@profiles/valid-full", "job": "@adverts/advert-python" },
      "expect": { "status": 403, "code": "consent_required" } },
    { "id": "ats-scan-valid", "method": "POST", "path": "/ats-scans",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_UNDER_18", "cvText": "$CV_TEXT", "job": "@adverts/advert-python" },
      "expect": { "status": 200, "bodyKeys": ["coveragePct", "flags", "matched", "missing", "missingMustHaves"] } },
    { "id": "ats-scan-purpose-not-consented", "method": "POST", "path": "/ats-scans",
      "body": { "learnerRef": "$LEARNER", "consent": "$CONSENT_DRAFT_ONLY", "cvText": "$CV_TEXT", "job": "@adverts/advert-python" },
      "expect": { "status": 403, "code": "consent_required" } }
  ]
}
