{
  "name": "@universityflow/documents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Document extraction schemas: reports, letters, registration proofs, marked scripts.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/sample-results.json": "./fixtures/sample-results.json",
    "./storage-contract": "./src/storage.contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .turbo coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/s3-presigned-post": "3.1142.0",
    "@universityflow/catalogue": "workspace:*",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@universityflow/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
