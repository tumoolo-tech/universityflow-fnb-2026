{
  "name": "@universityflow/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system and artifact components.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mark-calculator": "./src/mark-calculator.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .turbo coverage"
  },
  "dependencies": {
    "@universityflow/admissions": "workspace:*",
    "@universityflow/catalogue": "workspace:*",
    "@universityflow/content": "workspace:*",
    "@universityflow/tokens": "workspace:*"
  },
  "devDependencies": {
    "@universityflow/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
