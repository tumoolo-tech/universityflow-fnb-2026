{
  "name": "@universityflow/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scheduled jobs behind an interface: IDs-only payloads, an in-memory stand-in and the contract every scheduler meets. Server-only.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/jobs.contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .turbo coverage"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@universityflow/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
