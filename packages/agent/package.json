{
  "name": "@universityflow/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The agent: charter, tool definitions, crisis protocol, memory model, artifact schemas.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
