{
  "name": "@universityflow/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI evaluation suites, crisis red-team and graders. Synthetic or anonymised fixtures only.",
  "main": "./src/index.ts",
