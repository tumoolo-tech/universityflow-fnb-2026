{
  "name": "@universityflow/admissions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure admission calculators: per-university scores, eligibility, mark maths. No I/O.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .turbo coverage"
  },
  "devDependencies": {
    "@universityflow/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@universityflow/catalogue": "workspace:*"
  }
}
