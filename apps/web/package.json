{
  "name": "@universityflow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UniversityFlow web app: chat, artifacts, accounts and API routes.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .next .turbo coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c e2e/playwright.demo.config.ts && playwright test -c e2e/playwright.demo-phone.config.ts",
    "test:e2e:production": "playwright test -c e2e/playwright.production.config.ts"
  },
  "dependencies": {
    "@universityflow/admissions": "workspace:*",
    "@universityflow/agent": "workspace:*",
    "@universityflow/catalogue": "workspace:*",
    "@universityflow/content": "workspace:*",
    "@universityflow/cv": "workspace:*",
    "@universityflow/db": "workspace:*",
    "@universityflow/documents": "workspace:*",
    "@universityflow/jobs": "workspace:*",
    "@universityflow/messaging": "workspace:*",
    "@universityflow/tokens": "workspace:*",
    "@universityflow/ui": "workspace:*",
    "firebase": "12.19.0",
    "next": "^16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@universityflow/config": "workspace:*",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "4.13.0",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  }
}
