{
  "name": "@universityflow/native",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "UniversityFlow mobile app (iOS + Android).",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform ios --platform android --output-dir dist && node scripts/check-export.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "doctor": "expo-doctor",
    "clean": "rimraf .expo .turbo dist coverage"
  },
  "dependencies": {
    "@universityflow/admissions": "workspace:*",
    "@universityflow/catalogue": "workspace:*",
    "@universityflow/content": "workspace:*",
    "@universityflow/tokens": "workspace:*",
    "@universityflow/ui": "workspace:*",
    "expo": "~57.0.15",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-image-picker": "57.0.20",
    "expo-linking": "~57.0.7",
    "expo-notifications": "57.0.21",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "@universityflow/config": "workspace:*",
    "jest": "^29.7.0",
    "jest-expo": "57.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
